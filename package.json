{
  "name": "@quiltt/quiltt-sdks",
  "version": "1.0.0",
  "description": "Quiltt's Open Source Projects",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prebuild": "if [ \"$CI\" = \"true\" ]; then pnpm install --store=node_modules/.pnpm-store; fi && turbo run prebuild",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "bundlesize": "size-limit",
    "changeset": "npx changeset",
    "check:packages": "pnpm check-dependency-version-consistency .",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "publish": "pnpm run build:packages && npx changeset tag && pnpm -r publish --no-git-checks --filter=./packages/**",
    "test": "turbo run test",
    "test:unit": "vitest run --coverage",
    "test:e2e": "turbo run test:component",
    "typecheck": "turbo run typecheck",
    "version": "npx changeset version",
    "postversion": "pnpm exec pnpm install --filter=./packages/** "
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@size-limit/file": "12.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-native": "13.3.3",
    "@types/node": "24.12.2",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-istanbul": "4.1.3",
    "check-dependency-version-consistency": "6.0.0",
    "happy-dom": "20.8.9",
    "size-limit": "12.0.1",
    "turbo": "2.9.4",
    "vite": "8.0.7",
    "vitest": "4.1.3",
    "vitest-react-native": "0.1.5"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "detox",
      "dtrace-provider",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "@xmldom/xmldom@<=0.8.11": "^0.8.12",
      "brace-expansion@<=2.0.3": "^2.0.3",
      "brace-expansion@>=4.0.0<5.0.5": "^5.0.5",
      "h3@<=1.15.8": "^1.15.9",
      "iltorb": "npm:noop2@^2.0.0",
      "lodash@<=4.17.23": "^4.18.0",
      "node-forge@<=1.4.0": "^1.4.0",
      "serialize-javascript@<=7.0.5": "^7.0.5",
      "srvx@<0.11.13": "^0.11.13",
      "undici@<=7.24.1": "^7.24.1",
      "vite@<=7.3.2": "^7.3.2 || ^8.0.7"
    }
  },
  "size-limit": [
    {
      "path": "./packages/core/dist/index.js",
      "limit": "5 kB"
    },
    {
      "path": "./packages/react/dist/index.js",
      "limit": "10 kB"
    },
    {
      "path": "./packages/react-native/dist/index.js",
      "limit": "10 kB"
    },
    {
      "path": "./packages/vue/dist/index.js",
      "limit": "10 kB"
    },
    {
      "path": "./packages/capacitor/dist/index.js",
      "limit": "10 kB"
    }
  ]
}
