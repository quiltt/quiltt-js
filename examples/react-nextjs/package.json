{
  "name": "@quiltt/examples-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Quiltt's React SDK integrated into Next.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "TIMING=1 biome check src/ e2e/ playwright/ --fix",
    "playwright:install": "playwright install --with-deps chromium",
    "start": "next start",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test --project=e2e-chromium",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@quiltt/react": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.0",
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "encoding": "0.1.13",
    "postcss": "8.5.10",
    "tailwindcss": "4.1.18",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
