{
  "name": "@quiltt/react-native",
  "version": "6.1.2",
  "description": "React Native Components for Quiltt Connector",
  "homepage": "https://github.com/quiltt/quiltt-sdks/tree/main/packages/react-native#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiltt/quiltt-sdks.git",
    "directory": "packages/react-native"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/quiltt/quiltt-sdks/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "require": "./dist/components/index.cjs",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "require": "./dist/providers/index.cjs",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "bunchee",
    "clean": "rimraf .turbo dist",
    "dev": "bunchee --watch",
    "lint": "TIMING=1 biome check . --fix",
    "typecheck": "node node_modules/typescript-7/bin/tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@honeybadger-io/react-native": "6.4.7",
    "@quiltt/core": "workspace:*",
    "@quiltt/react": "workspace:*",
    "lodash.debounce": "4.0.8",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/base-64": "1.0.2",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "base-64": "1.0.0",
    "bunchee": "6.12.2",
    "react": "19.2.8",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "3.0.0",
    "react-native-webview": "13.15.0",
    "rimraf": "6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "base-64": "^1.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": ">=13.0.0"
  },
  "tags": [
    "quiltt",
    "react-native"
  ],
  "publishConfig": {
    "access": "public"
  }
}
