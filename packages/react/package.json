{
  "name": "@quiltt/react",
  "version": "6.1.2",
  "description": "React Components and Hooks for Quiltt Connector",
  "keywords": [
    "quiltt",
    "quiltt-connector",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/quiltt/quiltt-sdks/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiltt/quiltt-sdks.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/quiltt/quiltt-sdks/issues"
  },
  "sideEffects": [],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "require": "./dist/hooks/index.cjs",
      "import": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "require": "./dist/components/index.cjs",
      "import": "./dist/components/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "require": "./dist/providers/index.cjs",
      "import": "./dist/providers/index.js"
    },
    "./contexts": {
      "types": "./dist/contexts/index.d.ts",
      "require": "./dist/contexts/index.cjs",
      "import": "./dist/contexts/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "require": "./dist/utils/index.cjs",
      "import": "./dist/utils/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "bunchee",
    "clean": "rimraf .turbo dist",
    "dev": "bunchee --watch",
    "lint": "TIMING=1 biome check . --fix",
    "typecheck": "node node_modules/typescript-7/bin/tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.2",
    "@quiltt/core": "workspace:*",
    "use-debounce": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.12.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bunchee": "6.12.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "tags": [
    "quiltt",
    "react"
  ],
  "publishConfig": {
    "access": "public"
  }
}
