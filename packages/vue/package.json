{
  "name": "@quiltt/vue",
  "version": "6.1.1",
  "description": "Vue 3 Composables and Components for Quiltt Connector",
  "keywords": [
    "quiltt",
    "quiltt-connector",
    "vue",
    "vue3",
    "typescript"
  ],
  "homepage": "https://github.com/quiltt/quiltt-sdks/tree/main/packages/vue#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiltt/quiltt-sdks.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/quiltt/quiltt-sdks/issues"
  },
  "sideEffects": [],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./composables": {
      "types": "./dist/composables/index.d.ts",
      "require": "./dist/composables/index.cjs",
      "import": "./dist/composables/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "require": "./dist/components/index.cjs",
      "import": "./dist/components/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "require": "./dist/plugin/index.cjs",
      "import": "./dist/plugin/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "src/**",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "bunchee",
    "clean": "rimraf .turbo dist",
    "dev": "bunchee --watch",
    "lint": "TIMING=1 biome check . --fix",
    "typecheck": "node node_modules/typescript-7/bin/tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@apollo/client": "^4.2.2",
    "@quiltt/core": "workspace:*",
    "@vue/apollo-composable": "5.0.0-alpha.2",
    "@vueuse/core": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "24.12.2",
    "@vue/test-utils": "^2.4.11",
    "@wry/equality": "^0.5.7",
    "bunchee": "6.12.2",
    "graphql": "^16.13.0",
    "rimraf": "6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@7.0.2",
    "vue": "^3.5.40"
  },
  "peerDependencies": {
    "@wry/equality": "^0.5.6",
    "graphql": "^16.0.0",
    "rxjs": "^7.3.0",
    "vue": "^3.3.0"
  },
  "tags": [
    "quiltt",
    "vue"
  ],
  "publishConfig": {
    "access": "public"
  }
}
